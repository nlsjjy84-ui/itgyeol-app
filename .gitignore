# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# local test/publish scratch (not part of the app source)
/publish_mirror*/
/publish_assets*/

# 소개 화면 미리보기(한 파일에 그림까지 넣은 것)
/web-landing/preview.html

# 브라우저 테스트(npm run e2e) 결과물
dist-e2e/
test-results/
playwright-report/

# 소재 목록 원본·중간 결과(용량이 커서 올리지 않는다 — docs/MATERIALS.md 참고)
tools/catalog/raw/
tools/catalog/work/
tools/catalog/__pycache__/
dist-new/
dist-old/
shots/

# 업체 견적용 파일(메일 첨부용, 저장소에 올리지 않음)
견적*/
